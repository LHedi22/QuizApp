# Local (non-docker) development. Copy to .env and adjust.
# For the docker-compose stack use deploy/.env.example instead.

SECRET_KEY=dev-insecure-secret-key-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres. Spin one up with:
#   docker run --rm -d -p 127.0.0.1:5432:5432 -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=quizscan --name qs-pg postgres:16
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/quizscan

Q_WORKERS=2
