# Copy to deploy/.env before `docker compose ... up`. deploy/.env is gitignored.

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

# Host ports (bound to 127.0.0.1 only). Change if something else already listens
# (8000 and 5432 are commonly taken by other dev tooling). On Windows, a
# "socket ... forbidden" bind error means the port is in a WinNAT-reserved range:
#   netsh interface ipv4 show excludedportrange protocol=tcp
APP_PORT=8010
PG_PORT=5432

POSTGRES_USER=quizscan
POSTGRES_PASSWORD=quizscan
POSTGRES_DB=quizscan

WEB_WORKERS=3
Q_WORKERS=2

# Where deploy/backup.sh writes <timestamp>/{db.dump,blob.tar.gz,manifest.txt}.
# Gitignored. See deploy/RUNBOOK.md.
BACKUP_DIR=deploy/backups
