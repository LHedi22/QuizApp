{
  "name": "quizscanapp-web",
  "private": true,
  "version": "0.0.0",
  "description": "Tailwind CSS build for app/web templates (no runtime JS bundling).",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/tailwind/input.css -o ./app/web/static/web/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/tailwind/input.css -o ./app/web/static/web/app.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}
